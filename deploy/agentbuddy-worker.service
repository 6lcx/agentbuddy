[Unit]
Description=AgentBuddy Worker
After=network.target

[Service]
User=agentbuddy
WorkingDirectory=/opt/agentbuddy
EnvironmentFile=/etc/agentbuddy.env
ExecStart=/opt/agentbuddy/backend/.venv/bin/python -m agentbuddy.worker
Restart=on-failure
KillMode=control-group
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
